<div class="rounded-4 border bg-white shadow-sm overflow-hidden">

  <div class="d-flex flex-column flex-sm-row align-items-start align-items-sm-center justify-content-between gap-2 border-bottom px-3 px-sm-4 py-3">

    <div class="d-flex align-items-center gap-2">
      
      @if (isViewingCompanyEmployees()) {
        <button (click)="backToCompanies()" class="btn btn-light btn-sm d-inline-flex align-items-center gap-1">
          <i class="bi bi-arrow-left"></i>
          <span>Back</span>
        </button>
      }

      <div>
        <h2 class="h5 fw-semibold mb-0 text-dark">
          {{ getPageTitle() }}
        </h2>

        <p class="mt-1 mb-0 small text-secondary">
          {{ getPageSubtitle() }}
        </p>
      </div>
    </div>

    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-sm-end">
      @if (canInviteUsers() && !isViewingCompanyEmployees()) {
        <button (click)="openInviteModal()" class="btn btn-primary btn-sm px-3 flex-fill flex-sm-grow-0 d-inline-flex align-items-center justify-content-center gap-2 shadow-sm">
          <i class="bi bi-envelope-fill"></i>
          <span>Invite User</span>
        </button>
      }

      @if (canCreateUsers() && !isViewingCompanyEmployees()) {
        <a routerLink="/admin/users/create" class="btn btn-primary btn-sm px-3 flex-fill flex-sm-grow-0 d-inline-flex align-items-center justify-content-center gap-2">
          <i class="bi bi-person-plus-fill"></i>
          <span>Add Company</span>
        </a>
      }
    </div>

  </div>

  @if (auth.role() === 'company') {
    <div class="border-bottom px-3 px-sm-4 py-3">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="d-flex align-items-center gap-2 rounded-pill bg-light p-1 shadow-sm">
          <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold" [class.btn-primary]="activeTab() === 'joined'" [class.btn-outline-primary]="activeTab() !== 'joined'" (click)="setActiveTab('joined')">
            <i class="bi bi-person-check-fill me-1"></i>
            Joined Users
          </button>
          <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold" [class.btn-primary]="activeTab() === 'invited'" [class.btn-outline-primary]="activeTab() !== 'invited'" (click)="setActiveTab('invited')">
            <i class="bi bi-envelope-paper-fill me-1"></i>
            Invited Users
          </button>
        </div>
      </div>
    </div>
  }

  <div class="table-responsive">

    <table class="table align-middle mb-0">

      <thead>
        <tr class="table-light">

          <th class="px-4 py-3 text-uppercase small fw-semibold text-secondary">
            Name
          </th>

          <th class="px-4 py-3 text-uppercase small fw-semibold text-secondary">
            Email
          </th>

          @if (!isViewingCompanies()) {
            <th class="px-4 py-3 text-uppercase small fw-semibold text-secondary">
              Role
            </th>

            <th class="px-4 py-3 text-uppercase small fw-semibold text-secondary">
              Status
            </th>
          }

          <th class="px-4 py-3 text-uppercase small fw-semibold text-secondary">
            Actions
          </th>

        </tr>
      </thead>

      <tbody>

        @if (displayedUsers().length === 0) {
        <tr>
          <td [attr.colspan]="isViewingCompanies() ? 3 : 5" class="px-4 py-4 text-center text-secondary">
            @if (isViewingCompanyEmployees()) {
              No employees found for this company.
            } @else {
              No {{ isViewingCompanies() ? 'companies' : 'users' }} found.
            }
          </td>
        </tr>
        } @else {
        @for (user of displayedUsers(); track user._id) {

        <tr [class.cursor-pointer]="isViewingCompanies()" (click)="isViewingCompanies() ? viewCompanyEmployees(user) : null">

          <td class="px-4 py-3">

            <div class="d-flex align-items-center gap-3">

              <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary-subtle text-primary fw-semibold" style="width: 40px; height: 40px;">
                {{ user.fullName?.charAt(0) || user.fullName?.charAt(0) }}
              </div>

              <div>
                <p class="fw-medium mb-0 text-dark">
                  {{ user.fullName }}
                </p>
              </div>

            </div>

          </td>

          <td class="px-4 py-3 text-secondary">
            {{ user.email }}
          </td>

          @if (!isViewingCompanies()) {
            <td class="px-4 py-3">

              <span class="badge rounded-pill bg-success-subtle text-success-emphasis px-3 py-2 fw-medium">
                {{ user.role }}
              </span>

            </td>

            <td class="px-4 py-3">

              <span 
                class="badge rounded-pill px-3 py-2 fw-medium"
                [ngClass]="getStatusBadgeClass(user.accountStatus)">
                {{ getStatusText(user.accountStatus) }}
              </span>

            </td>
          }

          <td class="px-4 py-3">
            @if (isViewingCompanies()) {
              <button (click)="viewCompanyEmployees(user); $event.stopPropagation()" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                <i class="bi bi-people-fill"></i>
                <span>View Employees</span>
              </button>
            } @else {
              <div class="d-flex gap-2">
                @if (auth.role() === 'company' && activeTab() === 'joined') {
                  <button (click)="viewUserSkills(user)" class="btn btn-sm btn-outline-info d-inline-flex align-items-center gap-1">
                    <i class="bi bi-lightbulb-fill"></i>
                    <span>Skills</span>
                  </button>
                }
              </div>
            }
          </td>

        </tr>

        }
        }

      </tbody>

    </table>

  </div>

</div>

<!-- Invite User Modal -->
@if (showInviteModal) {
  <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-semibold">Invite User</h5>
          <button type="button" class="btn-close" (click)="closeInviteModal()"></button>
        </div>
        <div class="modal-body pt-2">
          <p class="text-secondary small mb-4">
            Enter the email address to send an invitation. An auto-generated password will be sent to the user.
          </p>

          <form [formGroup]="inviteForm" (ngSubmit)="sendInvite()">
            <div class="mb-3">
              <label class="form-label fw-medium">Email Address</label>
              <input 
                type="email" 
                class="form-control" 
                [class.is-invalid]="inviteForm.get('email')?.invalid && inviteForm.get('email')?.touched"
                formControlName="email"
                placeholder="user@example.com"
                autofocus>
              @if (inviteForm.get('email')?.hasError('required') && inviteForm.get('email')?.touched) {
                <div class="invalid-feedback d-block">
                  Email is required
                </div>
              }
              @if (inviteForm.get('email')?.hasError('email') && inviteForm.get('email')?.touched) {
                <div class="invalid-feedback d-block">
                  Please enter a valid email address
                </div>
              }
            </div>

            @if (inviteError) {
              <div class="alert alert-danger py-2">
                {{ inviteError }}
              </div>
            }

            @if (inviteSuccess) {
              <div class="alert alert-success py-2">
                {{ inviteSuccess }}
              </div>
            }

            <div class="d-flex gap-2 mt-4">
              <button 
                type="button" 
                class="btn btn-light flex-fill"
                (click)="closeInviteModal()"
                [disabled]="isInviting">
                Cancel
              </button>
              <button 
                type="submit" 
                class="btn btn-primary flex-fill"
                [disabled]="inviteForm.invalid || isInviting">
                @if (isInviting) {
                  <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                  Sending...
                } @else {
                  <i class="bi bi-send-fill me-2"></i>
                  Send Invite
                }
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
}